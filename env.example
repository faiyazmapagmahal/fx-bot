# Rename this file to .env and fill in your values
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_client_id_here
# Optional: set this to a guild ID for instant command updates during testing.
# Leave blank to deploy commands globally (takes up to 1 hour to propagate).
GUILD_ID=

# --- Optional feature keys ---

# Powers /automod antinsfw image scanning. Free tier available at deepai.org.
DEEPAI_API_KEY=

# Powers /youtube. Create a project + API key in Google Cloud Console with
# the YouTube Data API v3 enabled. Free quota is generous for polling.
YOUTUBE_API_KEY=

# Powers /instagram and /tiktok. There is no official free API for watching
# another account's posts — these require a third-party provider (e.g. a
# RapidAPI Instagram/TikTok endpoint). Fill these in and wire up the fetch
# calls in src/socialWatch.js (marked with TODO comments) once you pick one.
INSTAGRAM_API_KEY=
TIKTOK_API_KEY=
